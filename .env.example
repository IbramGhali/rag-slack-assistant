# Copy to .env to change settings. Every value is optional; the defaults run offline.

# Retrieval
RAG_EMBEDDER=hash            # hash (offline, deterministic) | bge-small (needs: uv sync --extra embeddings)
RAG_RETRIEVAL=hybrid         # bm25 | dense | hybrid
RAG_RERANKER=none            # none | cross-encoder (needs the embeddings extra)
RAG_CHUNKING=section         # section | fixed
RAG_TOP_K=5
# Refuse when the best chunk's cosine similarity is below this. 0 = default per embedder
# (0.25 for hash, 0.65 for bge-small, both chosen from `rag eval --sweep`).
RAG_EVIDENCE_THRESHOLD=0
# Score multiplier for superseded policy versions (demoted, never deleted).
RAG_SUPERSEDED_PENALTY=0.5

# Recommended production-like configuration:
# RAG_EMBEDDER=bge-small
# RAG_RERANKER=cross-encoder

# Answer generation: fake (offline, extractive) | anthropic
RAG_LLM_PROVIDER=fake
RAG_ANSWER_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=

# Index storage. Empty = local SQLite in .rag/. With docker compose:
# RAG_DATABASE_URL=postgresql://rag:rag@localhost:5434/rag
RAG_DATABASE_URL=

# Slack (Socket Mode). See README "Connect to Slack".
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# RAG_LIVE_TESTS=0
